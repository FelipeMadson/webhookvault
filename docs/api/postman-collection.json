{
  "info": {
    "_postman_id": "col-webhookvault-felipe-madson",
    "name": "Webhookvault — Official API Collection",
    "description": "Coleção oficial de testes e integração para Webhookvault (webhookvault). Arquitetado por Felipe Madison (@FelipeMadson).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "test-staff-engineer-token-madison",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Liveness Probe",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Trace-Id",
            "value": "trace-pm-{{$guid}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifica a integridade imediata do serviço, tempo de atividade e status do subsistema WAL."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code é esperado (200, 201 ou 202)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
              "});",
              "",
              "pm.test('Tempo de resposta é compatível com SLA (< 250ms)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(250);",
              "});"
            ]
          }
        }
      ]
    },
